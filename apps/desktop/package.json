{
  "name": "@atlas/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas for macOS: Tauri 2 shell with a React UI and an AG-UI generative canvas.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "app:dev": "SDKROOT=$(xcrun --sdk macosx26.5 --show-sdk-path 2>/dev/null || xcrun --show-sdk-path) tauri dev",
    "app:build": "SDKROOT=$(xcrun --sdk macosx26.5 --show-sdk-path 2>/dev/null || xcrun --show-sdk-path) tauri build"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.3",
    "@ag-ui/core": "1.0.3",
    "@atlas/core": "workspace:*",
    "@tanstack/react-query": "5.104.3",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-opener": "2.7.2",
    "lucide-react": "1.48.0",
    "mermaid": "12.2.0",
    "motion": "14.3.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4"
  }
}
